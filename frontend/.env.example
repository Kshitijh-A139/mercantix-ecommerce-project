# Mercantix frontend — Vite env vars
# Copy to `.env.local` for local dev. `.env.production` is committed but values
# can still be overridden at build-time via shell env.

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:9090

# Admin pages: when "true" (default) the admin reads from mock data so the UI
# can be developed without admin backend endpoints. Set to "false" in any
# environment that has the real /api/admin/* routes deployed.
VITE_ADMIN_MOCKS=true
